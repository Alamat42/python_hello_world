def f(n):
    s= ''
    while n>0:
        s = f'{n %15:x}' + s
        n = n // 15
    return s
def A(s):
    count = 0
    if s.count('8') == 1:
        for x in s:
            if int(x, 15)>9:
                count += 1
        return count >= 2
    else:
        return False
count = 0
for c in range(15**4, 15**5):
    if A(f(c)):
        count+=1
print(count)